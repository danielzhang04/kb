# The curated skills source and generated runtime mirrors are hashed byte-for-byte
# by scripts/sync_skills.py (the drift/tamper detector). Pin them
# to LF so the sha256 manifest is identical on Windows and the Linux cloud VM;
# otherwise autocrlf smudging produces false drift on checkout.
/skills/curated/** text=auto eol=lf
/.claude/skills/** text=auto eol=lf
/.agents/skills/** text=auto eol=lf
/.claude/kb-kit/** text=auto eol=lf
/.agents/kb-kit/** text=auto eol=lf
/kit/** text=auto eol=lf

# Systemd units are templated byte-for-byte during VM bootstrap.
/deploy/systemd/*.service text eol=lf

# The golden canary suite is hashed byte-for-byte by scripts/canary.py
# (evals/MANIFEST.sha256 — the immutability/tamper guard). Pin the canary cards
# and the manifest to LF so the sha256 manifest is identical on Windows and the
# Linux cloud VM; otherwise autocrlf smudging breaks verify_manifest on checkout.
/evals/canaries/** text=auto eol=lf
/evals/MANIFEST.sha256 text=auto eol=lf

# Signed-approval verification fixture — the gpg keyrings, the git bundle, and
# meta.json must be byte-identical on Windows and the Linux cloud VM (autocrlf
# smudging would corrupt the ASCII-armored keys / the committed signed blobs).
/tests/fixtures/signed-approval/repo.bundle binary
/tests/fixtures/signed-approval/web-flow.gpg -text
/tests/fixtures/signed-approval/other-key.gpg -text
/tests/fixtures/signed-approval/meta.json -text

# Learning-proposal records are parsed by scripts/learning_proposals.py, whose closed
# grammar rejects CR structurally (P4 plan §3.1: "CR/NUL/control bytes ... reject
# structurally"). This repo runs core.autocrlf=true, so without a pin every committed
# record and fixture smudges to CRLF on checkout and the parser — and the Windows
# coordination checkout's whole read — fails closed forever. Pin them to LF.
/docs/proposals/learnings/** text=auto eol=lf
/tests/fixtures/learning-proposals-*.md text=auto eol=lf

# Generated control-plane schema modules are compared byte-for-byte by the
# generator check; pin them to LF so autocrlf cannot create false drift.
/dashboard/server/control/generated/** text=auto eol=lf
/deploy/control_plane_schema.py text=auto eol=lf

# HEARTBEAT.md is read live and compared against a stored fixture copy
# (dashboard/server/schedules/mirror.test.ts, tests/test_schedule_mirror.py). Pin
# both to LF so a Windows checkout (autocrlf) and the Linux cloud VM see identical
# bytes; otherwise the raw-byte compare is eol-fragile cross-platform.
/HEARTBEAT.md text eol=lf
/tests/fixtures/dashboard-v3-p4-mirror-vectors.json text eol=lf
/tests/fixtures/dashboard-v3-p6-contract-vectors.json text eol=lf
