# secrets — never committed
.env
.env.*
!.env.example
*.pem
*.key

# bulk / private zones (Drive-synced, desktop-only)
_data/
_private/

# python
.brain-index/
__pycache__/
*.pyc
.pytest_cache/
atlas/.venv/
.hygiene-report.json
.pytest-*/
.u10-pytest-tmp/

# dashboard (Node) — build + deps never committed
dashboard/node_modules/
dashboard/dist/
dashboard/dist-server/

# P3 focused-gate output. The Vitest JSON the closure asserter reads and the browser-matrix artefacts:
# both are per-run evidence, and a committed copy is exactly the stale green the asserter refuses.
dashboard/.p3-vitest-results.json
dashboard/.p3-browser/

# Dashboard display-name/short-ref ordinals. Daemon-local state, never coordination truth: the
# production copy lives under DASHBOARD_STATE_ROOT (AppData\Local\kb-dashboard), deliberately outside
# every git worktree. A copy inside the repo only ever means a test pointed its stateRoot here.
naming.json
kit/.rendered/
state/scratch/
dashboard/.artifacts/

# figment anchor images staged for pod uploads (image bulk stays untracked)
orgs/figment/pipeline/train/runs/anchors/
orgs/figment/research/10sorlabs-package/

# figment P1 — creator-001 lifecycle artifacts (batch.json/scores.json/gate.json stay
# tracked; the bulk and blind-grading secrets beside them never do). The repo-root
# source directory these anchors are staged from, and blind_pool image bulk staged
# for pod uploads (see orgs/figment/pipeline/expand/runs/_uploads/ below).
personas/anchors/
orgs/figment/personas/*/anchors/
orgs/figment/personas/*/batches/*/images/
orgs/figment/personas/*/batches/*/rejected/
orgs/figment/personas/*/batches/*/blind/
orgs/figment/personas/*/batches/*/blind-key.json
orgs/figment/personas/*/batches/*/board.html
orgs/figment/pipeline/*/runs/_uploads/
orgs/figment/pipeline/*/runs/out/
