[Unit]
Description=kb dashboard immutable platform
After=network-online.target

[Service]
Type=simple
User=kb-dashboard
Group=kb-dashboard
# The dashboard creates and prunes /var/lib/kb-shell/worktrees/<id> (owner kb-dashboard, group
# kb-shell, 02770) that the broker's children execute in. Without this it cannot even traverse the
# worktree root, and the whole PTY execution vertical is dead on the VM.
SupplementaryGroups=kb-shell
# UMask=0002 is load-bearing, not hygiene. The daemon runs `git worktree add` for every attempt, so
# ITS umask decides the modes git creates inside the run worktree. systemd's default 0022 makes git
# write 2755 directories and 644 files under the setgid kb-shell group, and the worker process (uid
# kb-shell, a different account) can then only READ the tree it was handed - every write inside the
# run worktree fails. 0002 makes the same git create 2775/664, group-writable by kb-shell.
# This removes no control: the workflow contract (orgs/kb-ops/workflows/acceptance-run.md) is
# "the worker writes into orgs/kb-ops/output/, the control plane inspects `git status` and commits",
# and write-scope enforcement is post-hoc over that status (dashboard/server/control/adapters.ts),
# never filesystem modes. The broker's fd-pinning validator (dashboard/server/pty/fdPinnedPaths.ts)
# only checks the pinned cwd chain, which adapters.ts#chmodWorktreeComponents still re-forces to
# EXACTLY 02770 after creation. Asserted by deploy/validate_vm_runtime.py's static phase.
UMask=0002
RuntimeDirectory=kb-dashboard
RuntimeDirectoryMode=0750
WorkingDirectory=/opt/kb-releases/current/dashboard
Environment=DASHBOARD_PLATFORM_ROOT=/opt/kb-releases/current
Environment=PYTHONPATH=/opt/kb-releases/current
Environment=DASHBOARD_REPO_ROOT=/var/lib/kb/ops
Environment=DASHBOARD_STATE_ROOT=/var/lib/kb/state
Environment=DASHBOARD_EXECUTION_ACTIVATED=0
Environment=KB_COORDINATION_PUBLICATION=outbox
Environment=KB_VM_RUNTIME=1
Environment=GIT_CONFIG_GLOBAL=/dev/null
# Tailnet-trust auth mode: every request proven to have arrived through the tailnet-only
# `tailscale serve` proxy IS the operator, and execution is armed at boot. The site-specific
# DASHBOARD_TAILNET_HOST is injected by bootstrap_vm.py. The emergency brake is the STOP file plus
# `systemctl stop` — both non-interactive. DASHBOARD_EXECUTION_ACTIVATED stays 0: arming comes from the
# mode, not that gate. See docs/superpowers/specs/2026-08-18-tailnet-trust-mode-design.md.
Environment=DASHBOARD_AUTH_MODE=tailnet
# REQUIRED, fail-closed (Daniel, 2026-08-18): the single tailnet identity that IS the operator. Pinned
# because tailnet membership on this VM is root-equivalent (passwordless sudo), so an unpinned operator
# would grant authority to every node on the tailnet. bootstrap_vm.py injects the value.
# Also injected there, and equally REQUIRED (dashboard-v3 P5 [P5-C42]): DASHBOARD_DESKTOP_HELPER_ORIGIN,
# the one desktop-helper tailnet address the deploy/asset-pull client speaks to. The client fails
# composition without it, and bootstrap_vm.py refuses to render a unit missing anything
# validate_vm_runtime.py's EXPECTED_UNIT_ENV requires.
UnsetEnvironment=GITHUB_TOKEN GH_TOKEN GIT_ASKPASS SSH_AUTH_SOCK DASHBOARD_SESSION_SECRET KB_CANARY_SESSION
ExecStartPre=/usr/bin/python3 -I -B /usr/local/lib/kb/validate_vm_runtime.py --phase static --ops-root /var/lib/kb/ops --unit kb-dashboard.service
ExecStart=/usr/bin/node --experimental-strip-types server/index.ts
Restart=on-failure
KillMode=control-group
TimeoutStopSec=90
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/kb-releases
ReadWritePaths=/var/lib/kb/state /var/lib/kb/ops

[Install]
WantedBy=multi-user.target
