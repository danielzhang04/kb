[Unit]
Description=kb schedule dispatch tick timer (every 5 minutes)

[Timer]
# Every 5 minutes, on the hour boundary (:00, :05, :10, ...). Ruling (queue/inbox/2c3d4e5f-708192a3.md,
# approved by Daniel 2026-09-17): systemd timer on the VM running the dispatcher every 5 minutes.
OnCalendar=*:0/5
# A tick missed while the VM was down (reboot, outage) fires once on the next boot rather than being
# silently skipped until the next natural 5-minute boundary.
Persistent=true
Unit=kb-dispatch.service

[Install]
WantedBy=timers.target
