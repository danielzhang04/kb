[Unit]
Description=kb one-shot Codex queue runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kb-dashboard-ops
EnvironmentFile=%h/.config/kb/env
Environment=PATH=%h/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh %h/kb/scripts/agent_runner.sh --agent codex-worker --repo-root %h/kb-dashboard-ops --push-remote origin
StandardOutput=journal
StandardError=journal
