    "macgregor": {
      "role": "Gregor MacGregor \u2014 the con-man 'Cazique of Poyais'; recurring lead antagonist.",
      "head_tone": "#d9ac82",
      "costume": "PINNED canonical outfit: deep crimson hussar coat with gold frogging, gold fringed epaulettes, silver-ribboned gold order-star medal (his self-awarded-decorations identity tag), dark trousers, dark boots; swept dark-brown hair + mutton-chop sideburns. Every appearance renders in this unless the shot deliberately authors a change (e.g. prince regalia over it).",
      "base": "channels/the-second-take/visual-kit/refs/macgregor/macgregor-base.png"
    },
    "bolivar": {
      "role": "Sim\u00f3n Bol\u00edvar \u2014 the South-American liberator general; MacGregor's celebrated comrade-in-arms (appears L18).",
      "head_tone": "#b39a63",
      "costume": "PINNED canonical outfit: dark navy-blue liberator general's military coat with gold epaulettes and gold trim, a single bright red ceremonial sash worn diagonally across the chest, a black liberator's bicorne hat worn corner-forward, dark trousers and boots; short dark curly hair with prominent dark sideburns. Every appearance renders in this unless the shot deliberately authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/bolivar/bolivar.png"
    },
    "mosquito-king": {
      "role": "The Miskito Coast king who granted MacGregor the Poyais land in 1820 (appears L19\u2013L20).",
      "head_tone": "#8a5a3c",
      "costume": "PINNED canonical outfit: a tall gold crown and a full-length ornate red-and-gold patterned ceremonial robe with British-influenced regalia (gold braiding, epaulettes, a red-and-gold patterned mantle over the shoulders); short dark hair. Every appearance renders in this unless the shot deliberately authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/mosquito-king/mosquito-king.png"
    },
    "strangeways": {
      "base": "channels/the-second-take/visual-kit/refs/strangeways/strangeways.png",
      "head_tone": "#f5ead6",
      "role": "Captain Thomas Strangeways \u2014 the fictitious 'author' of the Poyais guidebook (invented by MacGregor to sell the con); a bookish naval author-captain. Appears L35/L43/L44.",
      "costume": "PINNED canonical outfit: plain dark navy double-breasted captain coat with a high collar and two rows of small brass buttons, thin round wire spectacles, short neat dark-brown hair combed down over the sides, dark trousers and boots. Renders in this unless a shot authors a change."
    },
    "hastie": {
      "base": "channels/the-second-take/visual-kit/refs/hastie/hastie.png",
      "head_tone": "#f5ead6",
      "role": "James Hastie \u2014 a weary Scottish sawyer and a leader of the Poyais settler survivors; signs the sworn statement exposing the fraud. Appears L104/L106.",
      "costume": "PINNED canonical outfit: worn brown working-man coat over a tan waistcoat and dark neckcloth, tousled greying-brown hair, sturdy build, plain trousers and boots. Renders in this unless a shot authors a change."
    },
    "hastie-wife": {
      "base": "channels/the-second-take/visual-kit/refs/hastie-wife/hastie-wife.png",
      "head_tone": "#f5ead6",
      "role": "The wife of James Hastie \u2014 a Poyais settler survivor at his side; quiet grief on the grey British quay. Appears L104.",
      "costume": "PINNED canonical outfit (human-picked cand-1, 2026-07-16): long muted-earth wool dress, dark shawl, apron, worn boots, cream linen mob cap, front-facing neutral. Renders in this unless a shot authors a change."
    },
    "miniscribe-rep": {
      "role": "MiniScribe personified \u2014 the disk-drive company as an actor; the bricks story's lead. Appears L26-L35, L39, L40.",
      "head_tone": "#e2b78c",
      "costume": "PINNED canonical outfit: boxy tan blazer worn open over a brown open-collar shirt, plain dark trousers and dark shoes, and ONE small steel-grey drive-shaped enamel badge pinned at the left lapel (its single identity tag); short dark-brown side-parted hair, stocky build. Renders in this unless a shot authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/miniscribe-rep/miniscribe-rep.png"
    },
    "ibm-suit": {
      "role": "IBM personified \u2014 the customer institution as an actor; MiniScribe's PC/XT contract buyer. Appears L30, L39.",
      "head_tone": "#7a4f33",
      "costume": "PINNED canonical outfit: crisp navy pinstripe three-piece suit (jacket, matching waistcoat, trousers) over a white shirt with a plain dark tie, ONE plain white pocket square folded at the breast pocket (its single identity tag), polished dark shoes; close-cropped grey hair, broad heavy mass on the squat base proportion. Renders in this unless a shot authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/ibm-suit/ibm-suit.png"
    },
    "terry-johnson": {
      "role": "Terry Johnson \u2014 MiniScribe's founder; depicted at work and at his late-1984 departure. Appears L28, L42.",
      "head_tone": "#f5ead6",
      "costume": "PINNED canonical outfit: white business shirt in shirtsleeves with both cuffs turned back to the forearm, a thin dark tie, plain dark trousers and dark shoes, no jacket; thinning fair hair combed back with the side hair filling the ear gap, one small trimmed fair moustache, lean build. Renders in this unless a shot authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/terry-johnson/terry-johnson.png"
    },
    "pc-boxy": {
      "role": "Personified beige boxy 1980s home computer \u2014 a FACED machine character (not a human). The cast's cartoon eyes and mouth sit in its front panel; short stubby arms and legs, NO hands. Appears L01-L04, L16.",
      "head_tone": "#e8dcc0",
      "costume": "PINNED canonical form: beige boxy home-computer case with the cast's cartoon eyes and mouth set into the front panel, short stubby arms and legs. NOTE: a personified OBJECT \u2014 never seed a human torso POSE frame onto it (bleeds a human body); expression frames route to the face panel and stance is carried in words.",
      "base": "channels/the-second-take/visual-kit/refs/pc-boxy/pc-boxy.png",
      "no_hands": true
    },
    "qt-wiles": {
      "role": "Q.T. Wiles \u2014 the 'turnaround chairman', 'Dr Fix-It'; severe, older cast member installed to run MiniScribe. Appears across the bricks-fresh video from L45.",
      "head_tone": "#d3a878",
      "costume": "PINNED canonical outfit: steel-grey three-piece suit, silver-grey hair swept straight back, a stethoscope draped loosely round the neck over the lapel (his 'Dr Fix-It' identity tag); severe, older executive bearing carried as linework (brow creases), never a reshaped head. A white doctor's coat worn OVER this suit is an authored costume delta for the doctor-fixit-clinic beat only. Renders in the plain steel-grey suit unless a shot authors the coat.",
      "base": "channels/the-second-take/visual-kit/refs/qt-wiles/qt-wiles.png"
    },
    "hq-banker": {
      "role": "Hambrecht & Quist personified \u2014 the bank's own institutional actor; installs Wiles, recurs at the verdict beat. Appears from L45.",
      "head_tone": "#e6c69c",
      "costume": "PINNED canonical outfit: rich chocolate-brown pinstripe three-piece suit, a gold pocket-watch chain looped at the waistcoat (his one identity tag), silver hair combed neatly back. Renders in this unless a shot authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/hq-banker/hq-banker.png"
    },
    "brick-foreman": {
      "role": "A recurring MiniScribe middle manager \u2014 the ground-level executor of the escalating fraud across the quota, lockbox, brick and packing beats. Appears from L60.",
      "head_tone": "#cf8f5c",
      "costume": "PINNED canonical outfit: pale short-sleeve button shirt with a black clip-on tie, plain trousers, plain brown side-parted hair, an ordinary working build. Renders in this unless a shot authors a change.",
      "base": "channels/the-second-take/visual-kit/refs/brick-foreman/brick-foreman.png"
    },
    "auditor-rep": {
      "role": "Coopers & Lybrand personified \u2014 the outside accounting firm's own institutional actor; recurs through the test-count and verdict beats. Appears from L76.",
      "head_tone": "#a67c52",
