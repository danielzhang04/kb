# Copy this file to .env and fill in values as you connect each tool.
# NEVER commit .env. Only .env.example (this file, with blank values) is tracked.

# --- Voice (text-to-speech) ---
ELEVENLABS_API_KEY=

# --- Render / video assembly (pick one provider) ---
JSON2VIDEO_API_KEY=
# CREATOMATE_API_KEY=
# SHOTSTACK_API_KEY=

# --- Image / illustration generation ---
RECRAFT_API_KEY=           # flat-vector house style + true SVG (external.api.recraft.ai)
GEMINI_API_KEY=            # Nano Banana (Gemini image) — scenes + character consistency
# FAL_API_KEY=             # optional gateway (Flux LoRA, etc.)
# REPLICATE_API_TOKEN=

# --- YouTube (Data API v3 + Analytics API), OAuth ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

