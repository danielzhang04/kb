# Secrets — never commit
.env
.env.local
*.secret

# Generated media assets (large binaries, regenerable).
# Ignore the CONTENTS, not the directory: a plain `assets/` exclusion stops git descending
# into the tree at all, so the reasoning that lives alongside the frames — image-gen-lab.md,
# the asset manifests, the batch planners — was silently untracked too. Those are small,
# hand-authored and NOT regenerable; losing them loses every lesson a run paid to learn.
# Binaries stay ignored here AND by the extension rules below.
channels/*/videos/*/assets/**
!channels/*/videos/*/assets/**/
!channels/*/videos/*/assets/**/*.md
!channels/*/videos/*/assets/**/*.json
!channels/*/videos/*/assets/**/*.py
!channels/*/videos/*/assets/**/*.txt
*.mp3
*.wav
*.mp4
*.mov

# Runtime / deps
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Logs (keep the folder, ignore contents except .gitkeep)
logs/*
!logs/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Scratch / test video slugs (underscore-prefixed; regenerable pipeline test beds —
# e.g. _poyais-test-slice, _pearlman-test-act1). Real videos use YYYY-MM-DD-slug and stay tracked.
channels/*/videos/_*/

# visual-kit scratch + staging (exploration/QC; regenerable)
channels/*/visual-kit/_*/

# sfx-forge audition scratch (regenerable; manifest.json is the durable record)
channels/*/visual-kit/audio/_audition/

# audio-analyzer Demucs stems (large regenerable binaries; the report.json/md is the durable record)
channels/*/visual-kit/research/audio-logs/_stems/

# Remotion render cache (created at cwd by render-video.mjs)
.remotion/

# analytics: raw pulls + generated dashboard are regenerable, keep out of git (rollup.json and performance.md digests ARE tracked)
analytics/*/raw/
analytics/dashboard.html
