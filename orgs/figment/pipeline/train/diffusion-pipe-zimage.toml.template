# diffusion-pipe starting template for a ~40-image Z-Image Base character LoRA.
# Project starting values, not an upstream model-specific character prescription.
output_dir = '{{output_dir}}/{{trigger}}'
dataset = '{{dataset_dir}}/dataset.toml'
max_steps = 1600
micro_batch_size_per_gpu = 1
pipeline_stages = 1
gradient_accumulation_steps = 1
gradient_clipping = 1.0
warmup_steps = 100
save_every_n_steps = 200
checkpoint_every_n_minutes = 30
activation_checkpointing = 'unsloth'
partition_method = 'parameters'
save_dtype = 'bfloat16'
caching_batch_size = 1
steps_per_print = 5

# For a 24 GB card, begin with 8 swapped blocks and measure. A 48 GB card should
# first try blocks_to_swap = 0. Neither figure is an upstream measured guarantee.
blocks_to_swap = 8

[model]
type = 'z_image'
diffusion_model = '/workspace/ComfyUI/models/diffusion_models/z_image_bf16.safetensors'
vae = '/workspace/ComfyUI/models/vae/ae.safetensors'
text_encoders = [
  {path = '/workspace/ComfyUI/models/text_encoders/qwen_3_4b.safetensors', type = 'lumina2'},
]
dtype = 'bfloat16'
# Uncomment only if a measured 24 GB run needs it; upstream documents a small
# quality cost. Do not use the Turbo training adapter with this Base arm.
# diffusion_model_dtype = 'float8'

[adapter]
type = 'lora'
rank = 32
dtype = 'bfloat16'

[optimizer]
type = 'AdamW8bitKahan'
lr = 5e-5
betas = [0.9, 0.99]
weight_decay = 0.01
stabilize = false

[monitoring]
enable_wandb = false
wandb_api_key = ''
wandb_tracker_name = ''
wandb_run_name = '{{trigger}}-zimage'
