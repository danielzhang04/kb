# diffusion-pipe starting template for a ~40-image FLUX.2 klein 4B Base character LoRA.
# Project starting values, not an upstream model-specific character prescription.
output_dir = '{{output_dir}}/{{trigger}}'
dataset = '{{dataset_dir}}/dataset.toml'
max_steps = 1600
micro_batch_size_per_gpu = 1
pipeline_stages = 1
gradient_accumulation_steps = 1
gradient_clipping = 1.0
warmup_steps = 100
save_every_n_steps = 200
checkpoint_every_n_minutes = 30
activation_checkpointing = 'unsloth'
partition_method = 'parameters'
save_dtype = 'bfloat16'
caching_batch_size = 1
steps_per_print = 5

# Upstream says 4B probably does not need fp8 except at very low VRAM. Start at
# zero swaps on 48 GB; on 24 GB, raise this only after a measured OOM.
blocks_to_swap = 0

[model]
type = 'flux2'
diffusion_model = '/workspace/ComfyUI/models/diffusion_models/flux-2-klein-base-4b.safetensors'
vae = '/workspace/ComfyUI/models/vae/flux2-vae.safetensors'
text_encoders = [
  {path = '/workspace/ComfyUI/models/text_encoders/qwen_3_4b.safetensors', type = 'flux2'},
]
dtype = 'bfloat16'
timestep_sample_method = 'logit_normal'
shift = 3

[adapter]
type = 'lora'
rank = 32
dtype = 'bfloat16'

[optimizer]
type = 'AdamW8bitKahan'
lr = 5e-5
betas = [0.9, 0.99]
weight_decay = 0.01
stabilize = false

[monitoring]
enable_wandb = false
wandb_api_key = ''
wandb_tracker_name = ''
wandb_run_name = '{{trigger}}-klein4b'
