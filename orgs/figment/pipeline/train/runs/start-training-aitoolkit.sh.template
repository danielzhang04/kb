#!/usr/bin/env bash
# Ostris AI Toolkit headless training launcher, rendered into the pod bootstrap by
# runpod_run.py and executed as comfyui.start_command. The harness appends
# --listen/--port/--output-directory, which reach ComfyUI through "$@".
#
# Order matters and is dictated by the harness: everything that can be done before
# ComfyUI answers /system_stats runs inside readiness_timeout_seconds; everything
# after the dataset marker runs inside job_timeout_seconds.
set -euo pipefail

trigger='{{trigger}}'
trainer_root='{{trainer_root}}'
train_output='{{train_output}}'
data_root="/workspace/ComfyUI/input/${trigger}"
config_file="${data_root}/{{config_name}}"
caption_mode='{{caption_mode}}'
caption_word='{{caption_word}}'
caption_model='{{caption_model}}'
min_images='{{dataset_min_images}}'
export HF_HOME='{{hf_home}}'
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

mkdir -p /workspace/output "$train_output" "$data_root" "$HF_HOME"
rm -f /workspace/output/_training.complete /workspace/output/_training.failed

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a /workspace/output/_training.log; }
fail() {
  printf '%s\n' "$*" > /workspace/output/_training.failed
  log "FAILED $*"
  exit 1
}

# --- 1. trainer install (readiness window) ------------------------------------
if [[ ! -d "$trainer_root/.git" ]]; then
  log 'cloning ai-toolkit'
  git clone --recurse-submodules https://github.com/ostris/ai-toolkit.git "$trainer_root" \
    || fail 'ai-toolkit clone failed'
fi
git -C "$trainer_root" fetch --depth 1 origin '{{git_ref}}' || fail 'ai-toolkit fetch failed'
git -C "$trainer_root" checkout --force '{{git_ref}}' || fail 'ai-toolkit checkout failed'
git -C "$trainer_root" submodule update --init --recursive || fail 'ai-toolkit submodules failed'

if [[ '{{reinstall_torch}}' == '1' ]]; then
  log 'installing upstream-pinned torch'
  python -m pip install --no-cache-dir '{{torch_spec}}' '{{torchvision_spec}}' \
    --index-url '{{torch_index_url}}' || fail 'torch install failed'
fi
python -m pip install --no-cache-dir -r "$trainer_root/requirements.txt" \
  || fail 'ai-toolkit requirements install failed'

# --- 2. pre-warm the HF cache for the two ungated companions -------------------
# Krea2Model loads its text encoder from Qwen/Qwen3-VL-4B-Instruct and its VAE from
# Qwen/Qwen-Image (subfolder vae). Pulling them now keeps them out of the job window.
python - <<'PYWARM' || fail 'hugging face pre-warm failed'
from huggingface_hub import snapshot_download
snapshot_download("Qwen/Qwen3-VL-4B-Instruct")
snapshot_download("Qwen/Qwen-Image", allow_patterns=["vae/*", "*.json"])
PYWARM
log 'hugging face pre-warm complete'

# --- 3. ComfyUI comes up; the harness only now uploads the dataset -------------
python /workspace/ComfyUI/main.py "$@" &
comfy_pid=$!
trap 'kill "$comfy_pid" 2>/dev/null || true' EXIT

while [[ ! -f "$data_root/_dataset.ready" ]]; do
  kill -0 "$comfy_pid" 2>/dev/null || fail 'ComfyUI stopped before dataset upload'
  sleep 2
done
log 'dataset marker observed'

# --- 4. dataset shape + captions (job window) ---------------------------------
mapfile -t images < <(find "$data_root" -maxdepth 1 -type f \
  \( -name '*.png' -o -name '*.jpg' -o -name '*.jpeg' \) | sort)
[[ ${#images[@]} -ge ${min_images} ]] \
  || fail "expected at least ${min_images} dataset images, found ${#images[@]}"
[[ -s "$config_file" ]] || fail 'training config was not uploaded'

case "$caption_mode" in
  provided)
    for image in "${images[@]}"; do
      [[ -s "${image%.*}.txt" ]] || fail "missing caption for $(basename "$image")"
    done
    ;;
  single_word)
    # Module 04/05 legacy fallback. Module 11 retired it; kept only as an option.
    for image in "${images[@]}"; do printf '%s\n' "$caption_word" > "${image%.*}.txt"; done
    ;;
  auto)
    # Module 11's captioner. UNVERIFIED on this harness: no pod has run it yet.
    log "auto-captioning with ${caption_model}"
    CAP_DIR="$data_root" CAP_MODEL="$caption_model" python - <<'PYCAP' || fail 'auto-caption failed'
import os, pathlib, torch
from transformers import AutoProcessor, AutoModelForImageTextToText
directory = pathlib.Path(os.environ["CAP_DIR"])
name = os.environ["CAP_MODEL"]
instruction = (
    "Caption this image as if you were going to try to generate it with an image "
    "generator. Be thorough. Do not say things like 'It appears that' or 'possibly'. "
    "Start out with things like 'A person on the beach'. No preamble."
)
processor = AutoProcessor.from_pretrained(name)
model = AutoModelForImageTextToText.from_pretrained(
    name, dtype=torch.bfloat16, device_map="auto"
).eval()
for image_path in sorted(directory.iterdir()):
    if image_path.suffix.lower() not in {".png", ".jpg", ".jpeg"}:
        continue
    sidecar = image_path.with_suffix(".txt")
    if sidecar.exists() and sidecar.stat().st_size:
        continue
    messages = [{"role": "user", "content": [
        {"type": "image", "url": str(image_path)},
        {"type": "text", "text": instruction},
    ]}]
    inputs = processor.apply_chat_template(
        messages, add_generation_prompt=True, tokenize=True,
        return_dict=True, return_tensors="pt",
    ).to(model.device)
    generated = model.generate(**inputs, max_new_tokens=128, do_sample=False)
    text = processor.batch_decode(
        generated[:, inputs["input_ids"].shape[1]:], skip_special_tokens=True,
    )[0].strip()
    sidecar.write_text(text + "\n", encoding="utf-8")
PYCAP
    ;;
  *)
    fail "unknown caption_mode: ${caption_mode}"
    ;;
esac
log 'captions ready'

# --- 5. train -----------------------------------------------------------------
cd "$trainer_root"
python run.py "$config_file" >> /workspace/output/_training.log 2>&1 \
  || fail 'ai-toolkit run.py failed'

# --- 6. publish ---------------------------------------------------------------
checkpoint_dir="${train_output}/${trigger}"
final=$(find "$checkpoint_dir" -maxdepth 1 -type f -name '*.safetensors' \
  -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
[[ -n "$final" && -s "$final" ]] || fail 'no LoRA safetensors produced'
cp "$final" "/workspace/output/${trigger}.safetensors"
find "$checkpoint_dir" -maxdepth 1 -type f -name '*.safetensors' -printf '%f\n' \
  | sort | python -c 'import json,sys; print(json.dumps(sorted(l.strip() for l in sys.stdin if l.strip())))' \
  > /workspace/output/_checkpoints.json
log "final checkpoint $(basename "$final")"
touch /workspace/output/_training.complete
wait "$comfy_pid"
