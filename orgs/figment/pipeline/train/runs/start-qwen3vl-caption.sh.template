#!/usr/bin/env bash
# Qwen3-VL-8B-Instruct auto-captioning launcher (M4), rendered into the pod
# bootstrap by runpod_run.py and executed as comfyui.start_command exactly the way
# start-training-aitoolkit.sh.template is -- the harness appends
# --listen/--port/--output-directory, which reach ComfyUI through "$@". ComfyUI is
# only ever used here for the harness's own health check and upload/output
# transport; the real work (captioning) runs as a background script, gated by the
# same complete_marker/failed_marker contract every other artifact-mode manifest
# (train, smoke) already uses.
#
# LIVE FAILURE 2026-09-16 (creator-001/live-20260916b, first live pod for this
# template): the python block below imports transformers/accelerate but the
# template installed no python deps, and the failure reason stayed on the pod --
# this script only ever logged to _caption.log, which the harness's own
# capture_training_diagnostics only fetches under the names _training.log /
# _training.heartbeat (pod/runpod_run.py TRAINING_DIAGNOSTIC_FILENAMES). Fixed by
# (a) installing the pinned caption deps (tensor-pins.yaml pins.caption.pip)
# before the python block runs, (b) writing the log the harness actually fetches
# (_training.log, with _caption.log kept as a symlink for humans), (c) a
# background heartbeat touch so a stall is visible before either marker appears,
# and (d) capturing the python traceback into that same log instead of letting it
# escape to wherever the pod's own stdout/stderr goes.
set -euo pipefail

trigger='{{trigger}}'
model_dir='{{caption_model_dir}}'
model_repo='{{caption_model_repo}}'
model_revision='{{caption_model_revision}}'
model_dtype='{{caption_model_dtype}}'
max_resolution='{{caption_max_resolution}}'
max_new_tokens='{{caption_max_new_tokens}}'
max_body_chars='{{caption_max_body_chars}}'
# Word-split deliberately below (not quoted at the call site): this is a
# space-separated list of pip specs, and the harness's own placeholder renderer
# (pod/runpod_run.py rendered_training_start_script) always shlex.quote()s a
# placeholder's whole substituted value as ONE shell word, so the split has to
# happen here, not there.
caption_pip_specs={{caption_pip_specs}}
images_root="/workspace/ComfyUI/input/${trigger}"
export HF_HOME='{{hf_home}}'

output_dir=/workspace/output
# The harness only fetches diagnostics under these two names (M4 fix): write the
# real log here and keep the old name as a symlink for anyone reading the pod by hand.
caption_log="${output_dir}/_training.log"
heartbeat_file="${output_dir}/_training.heartbeat"
mkdir -p "$output_dir" "$images_root" "$HF_HOME"
: > "$caption_log"
ln -sf "$(basename "$caption_log")" "${output_dir}/_caption.log"
rm -f "${output_dir}/_caption.complete" "${output_dir}/_caption.failed" "$heartbeat_file"

log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" | tee -a "$caption_log"; }
comfy_pid=''
heartbeat_pid=''
stop_heartbeat() {
  if [[ -n "$heartbeat_pid" ]] && kill -0 "$heartbeat_pid" 2>/dev/null; then
    kill "$heartbeat_pid" 2>/dev/null || true
    wait "$heartbeat_pid" 2>/dev/null || true
  fi
}
fail() {
  { printf '%s\n' "$*"; tail -n 60 "$caption_log" 2>/dev/null; } > "${output_dir}/_caption.failed"
  log "FAILED $*"
  stop_heartbeat
  if [[ -n "$comfy_pid" ]] && kill -0 "$comfy_pid" 2>/dev/null; then
    wait "$comfy_pid" || true
  fi
  exit 1
}

# a stalled pod (stuck pip install, stuck model load, no network) never got past
# _images.ready before -- give the harness's diagnostic poll something to read
# from the moment this script starts, well before either marker can appear.
( while sleep 30; do date -u > "$heartbeat_file"; done ) &
heartbeat_pid=$!

# --- 1. ComfyUI comes up; the harness only now uploads the images -------------
python /workspace/ComfyUI/main.py "$@" &
comfy_pid=$!

while [[ ! -f "${images_root}/_images.ready" ]]; do
  kill -0 "$comfy_pid" 2>/dev/null || fail 'ComfyUI stopped before images upload'
  sleep 2
done
log 'images marker observed'

# --- 2. install the pinned caption deps (tensor-pins.yaml pins.caption.pip) ----
# ComfyUI's own requirements.txt brings a transformers/accelerate pair that predates
# Qwen3-VL support; the pod image's torch is deliberately left alone (not in the
# pinned spec list), same restraint start-training-aitoolkit.sh.template uses for
# its own post-toolkit ComfyUI requirements restore.
log 'installing caption deps'
# shellcheck disable=SC2086  # intentional word-split of caption_pip_specs, see above
python -m pip install --no-cache-dir $caption_pip_specs >>"$caption_log" 2>&1 \
  || fail 'caption deps install failed'

# --- 3. caption every uploaded image with the pinned Qwen3-VL-8B-Instruct ------
log "captioning with ${model_repo}@${model_revision} (dtype=${model_dtype}, max_resolution=${max_resolution}, max_new_tokens=${max_new_tokens})"
IMAGES_DIR="$images_root" MODEL_DIR="$model_dir" MODEL_REPO="$model_repo" \
MODEL_REVISION="$model_revision" MODEL_DTYPE="$model_dtype" MAX_RES="$max_resolution" \
MAX_TOKENS="$max_new_tokens" MAX_BODY_CHARS="$max_body_chars" OUT_FILE="${output_dir}/captions.json" \
python - <<'PYCAP' >>"$caption_log" 2>&1 || fail 'qwen3vl captioning failed'
import json
import os
import pathlib
import sys
import traceback

import torch
from huggingface_hub import hf_hub_download
from transformers import AutoModelForImageTextToText, AutoProcessor

try:
    images_dir = pathlib.Path(os.environ["IMAGES_DIR"])
    model_dir = os.environ["MODEL_DIR"]
    repo_id = os.environ["MODEL_REPO"]
    revision = os.environ["MODEL_REVISION"]
    dtype_name = os.environ["MODEL_DTYPE"]
    max_resolution = int(os.environ["MAX_RES"])
    max_new_tokens = int(os.environ["MAX_TOKENS"])
    max_body_chars = int(os.environ["MAX_BODY_CHARS"])
    out_file = pathlib.Path(os.environ["OUT_FILE"])

    # The safetensors shards were already pinned and downloaded by the harness's own
    # manifest["models"] mechanism (verified sha256, no live weight fetch here). The
    # remaining small companion files (config/tokenizer/index) are fetched fresh at the
    # SAME pinned, immutable revision -- same precedent as this pod's own module-11
    # companion-model prewarm (Qwen3-VL-4B-Instruct / Qwen-Image).
    for filename in (
        "config.json", "generation_config.json", "model.safetensors.index.json",
        "tokenizer.json", "tokenizer_config.json", "chat_template.json",
        "preprocessor_config.json", "video_preprocessor_config.json",
        "merges.txt", "vocab.json",
    ):
        try:
            hf_hub_download(repo_id, filename, revision=revision, local_dir=model_dir)
        except Exception as exc:  # a handful of these are optional across revisions
            print(f"companion file {filename} unavailable: {exc}", file=sys.stderr)

    # LIVE FAILURE 2026-09-16 (second caption pod, 8bi3qae4icrz3t, $0.15): module 11's
    # "float8" is ai-toolkit's own quantize-time setting (qfloat8 via its quantizer at
    # train time), never a `from_pretrained(dtype=...)` LOAD dtype -- passing that
    # 8-bit float torch dtype here reaches transformers' `_set_default_dtype` ->
    # `torch.set_default_dtype(...)` -> `TypeError: couldn't find storage object
    # Float8_e4m3fnStorage`. There is no quantizer on this pod, so both settings load
    # bf16 weights; the 8B model in bf16 is ~16 GB, well inside the L40S's 48 GB.
    dtype_map = {"float8": torch.bfloat16, "bfloat16": torch.bfloat16}
    if dtype_name == "float8":
        print(
            "float8 is a quantize-time setting (module 11 / ai-toolkit); loading bf16 weights, no quantizer on this pod"
        )
    dtype = dtype_map.get(dtype_name)
    if dtype is None:
        raise SystemExit(f"unknown caption model dtype: {dtype_name}")

    instruction = (
"Caption this image as if you were going to try to generate it with an image "
"generator. Be thorough. Do not say things like 'It appears that' or 'possibly'. "
"Start out with things like 'A person on the beach'. No preamble."
)
    processor = AutoProcessor.from_pretrained(model_dir)
    model = AutoModelForImageTextToText.from_pretrained(
        model_dir, dtype=dtype, device_map="auto",
    ).eval()

    captions: dict[str, str] = {}
    for image_path in sorted(images_dir.iterdir()):
        if image_path.name == "_images.ready" or image_path.suffix.lower() not in {
            ".png", ".jpg", ".jpeg", ".webp",
        }:
            continue
        messages = [{"role": "user", "content": [
            {
                "type": "image", "url": str(image_path),
                "max_pixels": max_resolution * max_resolution,
            },
            {"type": "text", "text": instruction},
        ]}]
        inputs = processor.apply_chat_template(
            messages, add_generation_prompt=True, tokenize=True,
            return_dict=True, return_tensors="pt",
        ).to(model.device)
        generated = model.generate(**inputs, max_new_tokens=max_new_tokens, do_sample=False)
        text = processor.batch_decode(
            generated[:, inputs["input_ids"].shape[1]:], skip_special_tokens=True,
        )[0].strip()
        # m10: refuse a caption body with a newline/control character or over
        # max_body_chars (build_training_set.CAPTIONS_MAX_BODY_CHARS, rendered here as
        # {{caption_max_body_chars}}) -- never write a malformed body into the artifact
        # the harness downloads. The authoritative check lives in build_training_set.py's
        # own _collect_cells_qwen3vl, which re-validates every body it reads back; this
        # is a fail-fast mirror so a bad pod response never silently ships as a valid
        # artifact. LIVE FAILURE 2026-09-16 (third caption pod, $0.15): a genuine
        # max_new_tokens=128 caption came back ~560 chars and was wrongly rejected by a
        # hardcoded 500-char cap; the bound is now rendered from the same constant
        # build_training_set.py enforces, raised to 1200.
        if len(text) > max_body_chars or any(ord(ch) < 32 for ch in text):
            raise SystemExit(f"caption body invalid for {image_path.name}: {text!r}")
        captions[image_path.name] = text

    if not captions:
        raise SystemExit("no images were captioned")
    out_file.write_text(json.dumps(captions, ensure_ascii=False, indent=2), encoding="utf-8")
except SystemExit:
    raise
except BaseException:
    traceback.print_exc()
    raise
PYCAP
log 'captions written'
touch "${output_dir}/_caption.complete"
stop_heartbeat
wait "$comfy_pid"
