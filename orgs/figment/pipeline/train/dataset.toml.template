# Render {{dataset_dir}} as the ComfyUI input subfolder containing paired files:
#   image-001.png
#   image-001.txt
# Captions begin with {{trigger}} and describe only angle, light, distance, and wardrobe.
resolutions = [1024]
enable_ar_bucket = true
min_ar = 0.5
max_ar = 2.0
num_ar_buckets = 7
frame_buckets = [1]

[[directory]]
path = '{{dataset_dir}}'
caption_extension = '.txt'
num_repeats = 1
